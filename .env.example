# Copy this file to .env and adjust as needed (optional - sensible defaults are built in)

PORT=5000

# Secret used to sign auth tokens. Change this in production.
JWT_SECRET=reliefconnect-super-secret-change-me

# Comma separated list of origins allowed to call the API.
# Use * to allow any origin (fine for a hackathon demo).
CORS_ORIGIN=*

# Default admin account created automatically on first run.
ADMIN_EMAIL=admin@reliefconnect.org
ADMIN_PASSWORD=Admin@123
